{
  "name": "broll",
  "version": "0.1.1",
  "description": "Busque b-roll no Pexels + Pixabay, preview no hover, 1 clique baixa, arraste pronto pro CapCut.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --port 5173 & sleep 1 && electron .",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0"
  }
}
